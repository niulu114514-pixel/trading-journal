{
  "name": "trading-journal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "wrangler dev --port 8788",
    "dev:web": "vite",
    "build": "pnpm typecheck && vite build",
    "test": "vitest run",
    "typecheck": "pnpm typecheck:worker && pnpm typecheck:web",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.app.json",
    "types:bindings": "wrangler types src/worker-env.d.ts --include-runtime false",
    "check:bindings": "wrangler types src/worker-env.d.ts --include-runtime false --check",
    "deploy:preflight": "wrangler whoami && wrangler workflows list && wrangler d1 info trading-journal-db",
    "deploy": "pnpm build && pnpm deploy:preflight && wrangler deploy",
    "db:init": "wrangler d1 execute trading-journal-db --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute trading-journal-db --local --file=./schema.sql",
    "db:migrate": "wrangler d1 migrations apply trading-journal-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply trading-journal-db --local",
    "test:mcp:e2e": "node scripts/mcp-e2e.mjs"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "dompurify": "^3.4.14",
    "hono": "^4.13.5",
    "html-to-image": "^1.11.13",
    "lightweight-charts": "^5.2.1",
    "marked": "^18.0.11",
    "naive-ui": "^2.45.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.2",
    "@cloudflare/workers-types": "^5.20260831.1",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.5",
    "typescript": "5.9.3",
    "unplugin-vue-components": "32.1.0",
    "vite": "^8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.127.1"
  }
}
